# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
*.spec.bak

# PyInstaller build output (release artifacts are attached to GitHub Releases,
# not committed). The built .exe lands next to main.py (see pyinstaller.spec),
# not in a dist/ folder, so it's ignored by extension+location instead.
backend/build/
backend/dist/
backend/ytdlx_backend/*.exe
*.exe

# Claude Code local session runtime state (not project content)
.claude/scheduled_tasks.lock

# --- Node / extension tooling ---
node_modules/
extension/build/
*.xpi
*.crx

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Secrets (never commit) ---
.env
*.pem
*.key
!backend/ytdlx_backend/assets/icon.ico

# --- Local dev-only native messaging registration ---
backend/ytdlx_backend/dev_native_host_manifest*.json
